# Local PostgreSQL user for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose. Do not use in production.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database for docker compose.
POSTGRES_DB=app

# Host port mapped to backend container port 8080.
BACKEND_PORT=8080

# Host port mapped to frontend container port 3000.
FRONTEND_PORT=3000

# Browser-visible backend API origin for frontend builds.
NEXT_PUBLIC_API_URL=http://localhost:8080
