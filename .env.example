# Local PostgreSQL user for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# Optional host port for backend.
BACKEND_PORT=8080

# Optional host port for frontend.
FRONTEND_PORT=3000

# Browser-visible backend base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
